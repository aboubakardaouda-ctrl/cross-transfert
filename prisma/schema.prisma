generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Participant {
  id                String    @id @default(cuid())
  fullName          String
  email             String    @unique
  phone             String
  translatorId      String    @unique
  city              String
  participates      Boolean   @default(true)
  comment           String?
  language          String    @default("fr")
  status            String    @default("pending")
  invitationSent    Boolean   @default(false)
  invitationSentAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments          Payment[]
  history           HistoryLog[]

  @@index([email])
  @@index([translatorId])
  @@index([status])
}

model Payment {
  id            String      @id @default(cuid())
  amount        Float
  note          String?
  createdAt     DateTime    @default(now())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model HistoryLog {
  id            String      @id @default(cuid())
  action        String
  details       String?
  createdAt     DateTime    @default(now())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model EventSettings {
  id            String  @id @default("default")
  title         String  @default("Conférence Annuelle des Traducteurs Chinois")
  titleEn       String  @default("Annual Chinese Translators' Conference")
  titleZh       String  @default("中文译者年会")
  eventDate     String  @default("À confirmer")
  eventLocation String  @default("À confirmer")
  totalRequired Float   @default(25000)
  year          Int     @default(2025)
  updatedAt     DateTime @updatedAt
}
