# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret de session administrateur (changer en production — chaîne longue et aléatoire)
NEXTAUTH_SECRET="remplacer-par-une-chaine-aleatoire-longue"

# URL du site (sans slash final)
NEXTAUTH_URL="https://billetdinvitation.site"
SITE_URL="https://billetdinvitation.site"

# Identifiants de l'administrateur (compte unique)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changer-ce-mot-de-passe"

# Resend — envoi d'e-mails (https://resend.com)
RESEND_API_KEY="re_votre_cle_api_resend"

# E-mails
FROM_EMAIL="noreply@billetdinvitation.site"
ADMIN_EMAIL="votre-email@domaine.com"
